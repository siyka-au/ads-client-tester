<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.19">
  <POU Name="FB_BitPackingTest" Id="{a6bc5853-885c-4af3-a63d-71989381d060}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_BitPackingTest
VAR
	// Control
	nSeed : REFERENCE TO ULINT;

	// Outputs: bBitN = bit N of nSeed
	stBitPacking : ST_BitPacking;

	// Go-owned write target: the PLC never touches it
	stBitPackingWrite : ST_BitPacking;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// -----------------------------------------------------------------------
// bBitN := bit N of nSeed
// -----------------------------------------------------------------------
stBitPacking.bBit0 := (SHR(nSeed, 0) AND 1) = 1;
stBitPacking.bBit1 := (SHR(nSeed, 1) AND 1) = 1;
stBitPacking.bBit2 := (SHR(nSeed, 2) AND 1) = 1;
