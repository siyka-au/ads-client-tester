<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.19">
  <POU Name="FB_ArrayTest" Id="{9192877a-8775-42d7-8401-b5dcc7f52bd2}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_ArrayTest
VAR
	// Control
	nSeed : REFERENCE TO ULINT;

	// Scratch (derived-value working storage, not seed-test outputs)
	nSeedSt1 : ULINT;
	nScratch : ULINT;

	// Outputs
	(*
	 * Struct with an array inside -- three different array shapes as sibling
	 * members (arr1-arr3 above), not nested inside each other. This is the
	 * inverse of the "array of structs" case already covered elsewhere: here
	 * the struct-member traversal path (not the array-element path) is what
	 * has to independently reset/build each member's own arrayType tagging.
	 * If tagging leaked between siblings -- e.g. arr2's chain-boundary state
	 * bleeding into arr3's first dimension -- this is the shape that would
	 * catch it, since the three members sit directly next to each other with
	 * no array-of-array or struct-of-struct indirection to isolate them first.
	 *)
	st1 : ST_Array;
	 
	(*
	 * ARRAY-in-STRUCT-in-ARRAY: Tests whether the arrayType tag correctly
	 * resets/doesn't leak when addOffsetDepth transitions from array-element
	 * expansion into struct-member expansion — a real risk given the tag
	 * propagation is pointer-based.
	 *)
	arr1 : ARRAY[0..2,0..2] OF INT;
	 
	(*
	 * A multi-dim link immediately followed by another multi-dim link: two
	 * 2-dim links back to back (a[i,j][k,l]). More demanding than arr1 since
	 * every side of this chain boundary is multi-dim itself, not a single
	 * flat declaration with no boundary at all.
	 *)
	arr2 : ARRAY[0..1,0..1] OF ARRAY[0..1,0..1] OF INT;

	(*
	 * 3+ dims in one link, chained further: stresses that nothing hardcodes
	 * "at most 2 dims merge."
	 *)
	arr3 : ARRAY[0..1,0..1,0..1] OF ARRAY[0..1] OF INT;
	 
	(*
	 * Degenerate single-element dimension: a dimension with exactly 1 element
	 * (Elements=1), good for off-by-one bugs in the bound/overflow math.
	 *)
	arr4: ARRAY[5..5] OF ARRAY[0..9] OF INT;
	 
	(*
	 * Negative bounds on both sides of a mixed boundary: negative bounds
	 * combined with multi-dim and chaining at once (each individually tested
	 * already per the fork's history, never together).
	 *)
	arr5 : ARRAY[-5..5,-3..3] OF ARRAY[-9..-1] OF INT;
	
	(*
	 * Enum as the leaf type: does *Array.Elems end up holding Enum values
	 * correctly, and does isEnumDataType's special-casing (which already exists
	 * to stop enums being expanded as structs) interact safely with the new
	 * array-kind tagging.
	 *)
	arr6 : ARRAY[0..2,0..2] OF E_ArrayEnum;
	
	(*
	 * BIT-packed struct as the leaf type, multi-dim: combines two independent
	 * offset-math systems (bit-packing offsets, array multi-dim offsets) that
	 * have each been tested alone but maybe never together.
	 *)
	arr7 : ARRAY[0..2,0..2] OF ST_ArrayBits;
	
	(*
	 * 4+ level deep pure chain — just recursion depth, to make sure nothing
	 * assumes "at most 2 or 3 links."
	 *)
	arr8 : ARRAY[0..1] OF ARRAY[0..1] OF ARRAY[0..1] OF ARRAY[0..1] OF INT;
	
	(*
	 * 4 multi-dim links chained: Stresses both axes at once. nothing may assume
	 * "at most N links" (arr8's test) AND nothing may assume "a chain boundary
	 * only ever follows a single-dim link" (arr8's three links are all
	 * single-dim, giving it a fallback shape to lean on; this one has none)
	 * -- every one of the three chain boundaries must restart bracket
	 * nesting while two real dims merge via comma on *both* sides of it,
	 * four times over, with no single-dim link anywhere to paper over an
	 * off-by-one in "same declaration vs new declaration."
	 *)
	arr9 : ARRAY[0..1, 0..1] OF ARRAY[0..1, 0..1] OF ARRAY[0..1, 0..1] OF ARRAY[0..1, 0..1] OF INT;

	// Private
	// loop variables
	i : DINT;
	j : DINT;
	k : DINT;
	l : DINT;
	m : DINT;
	n : DINT;
	o : DINT;
	p : DINT;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[// st1 -- offset seed, same shapes as arr1/arr2/arr3
nSeedSt1 := nSeed + 1000000;
FOR i := 0 TO 2 DO
    FOR j := 0 TO 2 DO
        st1.arr1[i,j] := DINT_TO_INT(ULINT_TO_DINT(nSeedSt1) + i*2 + j*3);
    END_FOR
END_FOR
FOR i := 0 TO 1 DO
    FOR j := 0 TO 1 DO
        FOR k := 0 TO 1 DO
            FOR l := 0 TO 1 DO
                st1.arr2[i,j][k,l] := DINT_TO_INT(ULINT_TO_DINT(nSeedSt1) + i*2 + j*3 + k*5 + l*7);
            END_FOR
        END_FOR
    END_FOR
END_FOR
FOR i := 0 TO 1 DO
    FOR j := 0 TO 1 DO
        FOR k := 0 TO 1 DO
            FOR l := 0 TO 1 DO
                st1.arr3[i,j,k][l] := DINT_TO_INT(ULINT_TO_DINT(nSeedSt1) + i*2 + j*3 + k*5 + l*7);
            END_FOR
        END_FOR
    END_FOR
END_FOR

// arr1 : ARRAY[0..2,0..2] OF INT
FOR i := 0 TO 2 DO
    FOR j := 0 TO 2 DO
        arr1[i,j] := DINT_TO_INT(ULINT_TO_DINT(nSeed) + i*2 + j*3);
    END_FOR
END_FOR

// arr2 : ARRAY[0..1,0..1] OF ARRAY[0..1,0..1] OF INT
FOR i := 0 TO 1 DO
    FOR j := 0 TO 1 DO
        FOR k := 0 TO 1 DO
            FOR l := 0 TO 1 DO
                arr2[i,j][k,l] := DINT_TO_INT(ULINT_TO_DINT(nSeed) + i*2 + j*3 + k*5 + l*7);
            END_FOR
        END_FOR
    END_FOR
END_FOR

// arr3 : ARRAY[0..1,0..1,0..1] OF ARRAY[0..1] OF INT
FOR i := 0 TO 1 DO
    FOR j := 0 TO 1 DO
        FOR k := 0 TO 1 DO
            FOR l := 0 TO 1 DO
                arr3[i,j,k][l] := DINT_TO_INT(ULINT_TO_DINT(nSeed) + i*2 + j*3 + k*5 + l*7);
            END_FOR
        END_FOR
    END_FOR
END_FOR

// arr4 : ARRAY[5..5] OF ARRAY[0..9] OF INT (degenerate outer dim)
FOR i := 5 TO 5 DO
    FOR j := 0 TO 9 DO
        arr4[i][j] := DINT_TO_INT(ULINT_TO_DINT(nSeed) + i*2 + j*3);
    END_FOR
END_FOR

// arr5 : ARRAY[-5..5,-3..3] OF ARRAY[-9..-1] OF INT (negative bounds, multi-dim + chained)
FOR i := -5 TO 5 DO
    FOR j := -3 TO 3 DO
        FOR k := -9 TO -1 DO
            arr5[i,j][k] := DINT_TO_INT(ULINT_TO_DINT(nSeed) + i*2 + j*3 + k*5);
        END_FOR
    END_FOR
END_FOR

// arr6 : ARRAY[0..2,0..2] OF E_ArrayEnum
FOR i := 0 TO 2 DO
    FOR j := 0 TO 2 DO
        nScratch := nSeed + DINT_TO_UDINT(i)*2 + DINT_TO_UDINT(j)*3;
        CASE nScratch MOD 4 OF
			1: arr6[i,j] := E_ArrayEnum.Member2;
			2: arr6[i,j] := E_ArrayEnum.Member3;
			3: arr6[i,j] := E_ArrayEnum.Member4;
		ELSE
			arr6[i,j] := E_ArrayEnum.Member1;
		END_CASE
    END_FOR
END_FOR

// arr7 : ARRAY[0..2,0..2] OF ST_ArrayBits (64-bit pattern, bulk copy)
FOR i := 0 TO 2 DO
    FOR j := 0 TO 2 DO
        nScratch := nSeed + DINT_TO_ULINT(i)*2 + DINT_TO_ULINT(j)*3;
        MEMCPY(ADR(arr7[i,j]), ADR(nScratch), SIZEOF(arr7[i,j]));
    END_FOR
END_FOR

// arr8 : 4 single-dim links chained
FOR i := 0 TO 1 DO
    FOR j := 0 TO 1 DO
        FOR k := 0 TO 1 DO
            FOR l := 0 TO 1 DO
                arr8[i][j][k][l] := DINT_TO_INT(ULINT_TO_DINT(nSeed) + i*2 + j*3 + k*5 + l*7);
            END_FOR
        END_FOR
    END_FOR
END_FOR

// arr9 : 4 chained 2-D links (8 indices)
FOR i := 0 TO 1 DO
 FOR j := 0 TO 1 DO
  FOR k := 0 TO 1 DO
   FOR l := 0 TO 1 DO
    FOR m := 0 TO 1 DO
     FOR n := 0 TO 1 DO
      FOR o := 0 TO 1 DO
       FOR p := 0 TO 1 DO
        arr9[i,j][k,l][m,n][o,p] := DINT_TO_INT(ULINT_TO_DINT(nSeed) + i*2 + j*3 + k*5 + l*7 + m*11 + n*13 + o*17 + p*19);
       END_FOR
      END_FOR
     END_FOR
    END_FOR
   END_FOR
  END_FOR
 END_FOR
END_FOR]]></ST>
    </Implementation>
    <Method Name="FB_Init" Id="{fc026e65-e5f8-4ce3-a497-971dd1cce40d}">
      <Declaration><![CDATA[//FB_Init is always available implicitly and it is used primarily for initialization.
//The return value is not evaluated. For a specific influence, you can also declare the
//methods explicitly and provide additional code there with the standard initialization
//code. You can evaluate the return value.
METHOD FB_Init: BOOL
VAR_INPUT
    bInitRetains : BOOL; // TRUE: the retain variables are initialized (reset warm / reset cold)
    bInCopyCode : BOOL;  // TRUE: the instance will be copied to the copy code afterward (online change)
	nSeed : REFERENCE TO ULINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[THIS^.nSeed REF= nSeed;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>