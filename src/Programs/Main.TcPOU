<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.19">
  <POU Name="Main" Id="{151bda18-a213-42d0-86e0-e79837f085e9}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM Main
VAR
	nSeed : UDINT := 0;
	fbTickCounter : FB_TickCounter;
	bAutoMode : BOOL := FALSE;
	nAutoTickInterval : UDINT := 50;
	
	fbTypeTest : FB_TypeTest(nSeed := nSeed);
	fbStringTest : FB_StringTest(nSeed := nSeed);
	fbStructTest : FB_StructPackingTest(nSeed := nSeed);
	fbEnumTest : FB_EnumTest(nSeed := nSeed);
	fbBitPackingTest : FB_BitPackingTest(nSeed := nSeed);
	fbWriteTest : FB_WriteTest;
	
	fbGvlTest : FB_GvlTest(nSeed := nSeed);
	
	{attribute 'some_made_up_var_key':='some_made_up_var_value'}
	fbAttributeTest : FB_AttributeTest;	
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[fbTypeTest();
fbStringTest();
fbStructTest();
fbEnumTest();
fbBitPackingTest();
fbWriteTest();

fbGvlTest();

fbAttributeTest();

fbTickCounter(bExecute := bAutoMode, nAutoTickInterval := nAutoTickInterval);

IF bAutoMode AND fbTickCounter.bTrigger THEN
	nSeed := nSeed + 1;
END_IF]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>